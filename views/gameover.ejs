<%- include("partials/head", { title: "Game over" }) %>
<section class="card center">
  <p class="big">💥</p>
  <h1>Streak over at <%= streak %></h1>
  <p>
    <% if (mode === "flags") { %>
      That was <strong><%= flagEmoji(correct.code) %> <%= correct.name %></strong><% if (guess) { %>, not <%= guess.name %><% } %>.
    <% } else { %>
      The capital of <%= correct.name %> is <strong><%= correct.capital %></strong><% if (guess) { %>, not <%= guess.capital %><% } %>.
    <% } %>
  </p>
  <% if (streak > 0) { %>
    <form method="post" action="/scores" class="save">
      <input type="hidden" name="token" value="<%= token %>">
      <label for="nickname">Save your score</label>
      <div class="row">
        <input id="nickname" name="nickname" required minlength="2" maxlength="20" placeholder="Nickname" autocomplete="nickname">
        <button type="submit" class="btn">Save</button>
      </div>
    </form>
  <% } %>
  <p class="actions"><a class="btn" href="/play/<%= mode %>">Play again</a> <a class="btn ghost" href="/">Home</a></p>
</section>
<%- include("partials/foot") %>
